{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run fastapi dev app/main.py --host 0.0.0.0 --port 8000",
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "Install Backend Dependencies"
    },
    {
      "name": "Backend: Run Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "python -m pytest tests/ -v",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Backend: Run Tests with Coverage",
      "type": "node-terminal",
      "request": "launch",
      "command": "coverage run -m pytest tests/ && coverage report --include=\"app/*\" --omit=\"app/alembic/*,app/email-templates/*,app/file_processing/*,app/index_db/*,app/services/*,app/*_pre_start.py,app/initial_data.py\"",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Backend: Run Core Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "python -m pytest tests/test_utils.py tests/test_crud.py tests/core/ tests/api/test_deps.py -v",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      // "serverReadyAction": {
      //   "pattern": "Local:.*?(https?://\\S+)",
      //   "uriFormat": "%s",
      //   "action": "debugWithChrome"
      // }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Frontend + Backend",
      "configurations": [
        "Backend: FastAPI",
        "Frontend: Vite Dev Server"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      }
    }
  ],
  "tasks": [
    {
      "label": "Build EXE",
      "type": "shell",
      "command": "python build_tools/build_exe.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Launch App",
      "type": "shell",
      "command": "python build_tools/launch.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
