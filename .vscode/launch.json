{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Run Backend",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run fastapi run app/main.py --host 0.0.0.0 --port 8000",
      "cwd": "${workspaceFolder}/backend"
    }
  ],
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": [
        "Run Frontend",
        "Run Backend"
      ],
      "stopAll": true
    }
  ]
}