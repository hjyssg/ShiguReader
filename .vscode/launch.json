    {
      "name": "Run Frontend UT",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Run Backend UT",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}