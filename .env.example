# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="ShiguReader"

# Backend
# 本地开发（ENVIRONMENT=local）下，后端还会额外允许常见 LAN 段来源（10.x/172.16-31.x/192.168.x）
# 生产环境请仅保留明确白名单来源。
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# SQLite database URLs (recommended)
# Default for development (project root data dir)
INDEX_SQLITE_URL=sqlite:///../data/index.db
USER_SQLITE_URL=sqlite:///../data/user.db



# File System & Thumbnail settings
FS_ROOTS=
FAVORITE_DIR=
ALREADY_READ_DIR=
THUMB_CACHE_DIR=../data/thumb_cache
THUMB_CONCURRENCY=3
THUMB_TIMEOUT_SEC=10
THUMB_HEIGHT=350
